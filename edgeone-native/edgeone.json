{
  "name": "homer-native",
  "installCommand": "if [ -d __homer_static__/hs_a8f3c91e2b7d4e6f ]; then cp -a __homer_static__/hs_a8f3c91e2b7d4e6f/. . && rm -rf __homer_static__; fi && rm -f index.html assets/config.yml assets/config.yml.dist assets/config-demo.yml.dist assets/additional-page.yml.dist",
  "buildCommand": "",
  "outputDirectory": ".",
  "nodeVersion": "22",
  "headers": [
    {
      "source": "/resources/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=31536000,immutable"
        }
      ]
    },
    {
      "source": "/icons/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/icons/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/themes/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/tools/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/custom.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=86400"
        }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=86400"
        }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=86400"
        }
      ]
    }
  ]
}
